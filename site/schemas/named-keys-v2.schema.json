{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kazuhide.github.io/drmr/schemas/named-keys-v2.schema.json",
  "title": "drmr named key file (schema 2)",
  "description": "Editor assistance for private keys.json. Runtime checks decoded KID/URI uniqueness, complete PSSH data, URL syntax, byte/file bounds, output roles and private-file permissions. Never publish a real key file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outputs"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[!-~]+(?![\\s\\S])",
      "description": "Optional editor reference. drmr discards this value without fetching it or including it in diagnostics."
    },
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keys": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kid",
              "key"
            ],
            "properties": {
              "kid": {
                "$ref": "#/definitions/hex16"
              },
              "key": {
                "$ref": "#/definitions/hex16"
              }
            }
          }
        },
        "hls_keys": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "uri",
              "key"
            ],
            "properties": {
              "uri": {
                "$ref": "#/definitions/inputUri"
              },
              "key": {
                "$ref": "#/definitions/hex16"
              },
              "iv": {
                "$ref": "#/definitions/iv"
              }
            }
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}(?![\\s\\S])"
      },
      "additionalProperties": {
        "$ref": "#/definitions/output"
      },
      "description": "One domain per encrypted output ID; none for clear outputs. Runtime checks this map against outputs.json. Quick single-output commands select default."
    }
  },
  "definitions": {
    "hex16": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^[0-9a-fA-F]{32}(?![\\s\\S])"
    },
    "iv": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^(0x)?[0-9a-fA-F]{1,32}(?![\\s\\S])"
        }
      ],
      "description": "Associated IV, left padded to 16 bytes; optional lowercase 0x prefix. Omit for CENC/CBCS output keys."
    },
    "inputUri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\u0000-\u001f\u007f-\u009f]+(?![\\s\\S])",
      "description": "Exact input playlist key identifier; drmr never fetches it. The runtime limit is 4096 UTF-8 bytes."
    },
    "outputUri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\"\u0000-\u001f\u007f-\u009f]+(?![\\s\\S])",
      "description": "Identifier written to HLS playlists, never fetched by drmr. FairPlay requires skd://. The runtime limit is 4096 UTF-8 bytes."
    },
    "licenseUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#@\\s]+[^#\\s]*(?![\\s\\S])",
      "description": "Public HTTP(S) license URL with no credentials, whitespace or fragment. The Rust URL parser performs the complete syntax check. Never fetched by drmr."
    },
    "pssh": {
      "type": "string",
      "minLength": 44,
      "maxLength": 131072,
      "pattern": "^(?:[0-9a-fA-F]{2})+(?![\\s\\S])|^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])",
      "description": "One complete Widevine PSSH box in hexadecimal or Base64. Runtime checks the box, system ID, payload, KIDs and any declared scheme."
    },
    "signaling": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "system",
            "license_url"
          ],
          "properties": {
            "system": {
              "const": "playready"
            },
            "license_url": {
              "$ref": "#/definitions/licenseUrl"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "system"
          ],
          "properties": {
            "system": {
              "const": "multi-drm"
            },
            "widevine_pssh": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/definitions/pssh"
                }
              ]
            },
            "playready_license_url": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/definitions/licenseUrl"
                }
              ]
            },
            "fairplay": {
              "type": "boolean",
              "default": false
            }
          },
          "anyOf": [
            {
              "required": [
                "widevine_pssh"
              ],
              "properties": {
                "widevine_pssh": {
                  "type": "string"
                }
              }
            },
            {
              "required": [
                "playready_license_url"
              ],
              "properties": {
                "playready_license_url": {
                  "type": "string"
                }
              }
            },
            {
              "required": [
                "fairplay"
              ],
              "properties": {
                "fairplay": {
                  "const": true
                }
              }
            }
          ]
        }
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key"
      ],
      "properties": {
        "kid": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/hex16"
            }
          ]
        },
        "key": {
          "$ref": "#/definitions/hex16"
        },
        "hls_key_uri": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/outputUri"
            }
          ]
        },
        "iv": {
          "$ref": "#/definitions/iv"
        },
        "signaling": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/signaling"
            }
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "kid"
          ],
          "properties": {
            "kid": {
              "type": "string"
            },
            "iv": {
              "type": "null"
            }
          }
        },
        {
          "required": [
            "hls_key_uri"
          ],
          "properties": {
            "kid": {
              "type": "null"
            },
            "hls_key_uri": {
              "type": "string"
            },
            "signaling": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "fairplay"
                  ],
                  "properties": {
                    "system": {
                      "const": "multi-drm"
                    },
                    "fairplay": {
                      "const": true
                    },
                    "widevine_pssh": {
                      "type": "null"
                    },
                    "playready_license_url": {
                      "type": "null"
                    }
                  }
                }
              ]
            }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "signaling"
            ],
            "properties": {
              "signaling": {
                "type": "object",
                "required": [
                  "system"
                ],
                "properties": {
                  "system": {
                    "const": "playready"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "hls_key_uri": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "signaling"
            ],
            "properties": {
              "signaling": {
                "type": "object",
                "required": [
                  "fairplay"
                ],
                "properties": {
                  "fairplay": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "hls_key_uri"
            ],
            "properties": {
              "hls_key_uri": {
                "type": "string",
                "pattern": "^[Ss][Kk][Dd]://[^/?#@\\s]+[^#\\s]*(?![\\s\\S])"
              }
            }
          }
        }
      ]
    }
  }
}
