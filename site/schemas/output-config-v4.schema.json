{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kazuhide.github.io/drmr/schemas/output-config-v4.schema.json",
  "title": "drmr output configuration (schema 4)",
  "description": "Editor assistance for outputs.json. Runtime validation also checks unique output IDs, platform paths, file limits, matching keys and supported media.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outputs"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[!-~]+(?![\\s\\S])",
      "description": "Optional editor reference. drmr discards this value without fetching it or including it in diagnostics."
    },
    "schema_version": {
      "type": "integer",
      "const": 4
    },
    "output_dir": {
      "type": "string",
      "minLength": 1,
      "description": "Result directory relative to this file, unless overridden by --output-dir. Runtime checks platform path components and destination safety."
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/output"
      }
    }
  },
  "definitions": {
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "output_format",
        "encryption",
        "drms"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])",
          "not": {
            "enum": [
              "con",
              "prn",
              "aux",
              "nul",
              "com1",
              "com2",
              "com3",
              "com4",
              "com5",
              "com6",
              "com7",
              "com8",
              "com9",
              "lpt1",
              "lpt2",
              "lpt3",
              "lpt4",
              "lpt5",
              "lpt6",
              "lpt7",
              "lpt8",
              "lpt9"
            ]
          },
          "description": "Unique result subdirectory and named key domain. Runtime checks ID uniqueness across the output list."
        },
        "output_format": {
          "enum": [
            "mp4",
            "dash",
            "hls-fmp4",
            "hls-ts"
          ]
        },
        "encryption": {
          "enum": [
            "clear",
            "cenc",
            "cbcs",
            "hls-aes128",
            "hls-sample-aes"
          ]
        },
        "drms": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "widevine",
              "playready",
              "fairplay"
            ]
          },
          "description": "Explicit DRM declarations; [] still permits encryption without service-specific signaling."
        },
        "processing": {
          "enum": [
            "auto",
            "segments",
            "stitch"
          ]
        },
        "dash_addressing": {
          "enum": [
            "template",
            "template-timeline",
            "list",
            "base"
          ]
        },
        "external_manifest_check": {
          "type": "boolean",
          "default": false,
          "description": "Request the optional external final-manifest validators, in addition to native checks. Refused for MP4."
        },
        "manifest_profile": {
          "enum": [
            "base",
            "apple-vod"
          ]
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "output_format": {
                  "const": "mp4"
                },
                "encryption": {
                  "enum": [
                    "clear",
                    "cenc",
                    "cbcs"
                  ]
                },
                "drms": {
                  "maxItems": 0
                },
                "external_manifest_check": {
                  "const": false
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "dash_addressing"
                    ]
                  },
                  {
                    "required": [
                      "manifest_profile"
                    ]
                  }
                ]
              }
            },
            {
              "properties": {
                "output_format": {
                  "const": "dash"
                },
                "encryption": {
                  "enum": [
                    "clear",
                    "cenc",
                    "cbcs"
                  ]
                },
                "drms": {
                  "items": {
                    "enum": [
                      "widevine",
                      "playready"
                    ]
                  }
                },
                "manifest_profile": {
                  "const": "base"
                }
              }
            },
            {
              "properties": {
                "output_format": {
                  "const": "hls-fmp4"
                },
                "encryption": {
                  "enum": [
                    "clear",
                    "cenc",
                    "cbcs",
                    "hls-aes128"
                  ]
                }
              },
              "not": {
                "required": [
                  "dash_addressing"
                ]
              }
            },
            {
              "properties": {
                "output_format": {
                  "const": "hls-ts"
                },
                "encryption": {
                  "enum": [
                    "clear",
                    "hls-aes128",
                    "hls-sample-aes"
                  ]
                },
                "drms": {
                  "items": {
                    "const": "fairplay"
                  }
                }
              },
              "not": {
                "required": [
                  "dash_addressing"
                ]
              }
            }
          ]
        },
        {
          "if": {
            "properties": {
              "encryption": {
                "enum": [
                  "clear",
                  "hls-aes128"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "drms": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "encryption": {
                "const": "cenc"
              }
            }
          },
          "then": {
            "properties": {
              "drms": {
                "items": {
                  "enum": [
                    "widevine",
                    "playready"
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
